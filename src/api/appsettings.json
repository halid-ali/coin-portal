{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Logs": {
    "Path": "App_Data/logs",
    "RetainedDays": 30
  },
  "DataProtection": {
    "KeysPath": "App_Data/keys",
    "Dpapi": "CurrentUser"
  },
  "RateLimiting": {
    "Auth": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Public": { "PermitLimit": 120, "WindowSeconds": 60 },
    "Photos": { "PermitLimit": 600, "WindowSeconds": 60 },
    "Export": { "PermitLimit": 3, "WindowSeconds": 600 },
    "Email": { "PermitLimit": 3, "WindowSeconds": 600 }
  },
  "AllowedHosts": "*",
  "Admin": {
    "UserIds": []
  },
  "AccountCleanup": {
    "IntervalHours": 6
  },
  "UserLimits": {
    "MaxCollections": 50,
    "MaxCoins": 10000
  },
  "Email": {
    "SiteUrl": "http://localhost:4200",
    "FromAddress": "contact@coinvitrine.com",
    "FromName": "CoinVitrine",
    "PickupPath": "App_Data/mail"
  },
  "PhotoStorage": {
    "RootPath": "App_Data/photos",
    "MaxUploadBytes": 10485760,
    "MaxSourceDimension": 4000,
    "MaxConcurrentDecodes": 2,
    "UserQuotaBytes": 314572800,
    "WebpQuality": 80,
    "SweepIntervalHours": 24
  }
}
