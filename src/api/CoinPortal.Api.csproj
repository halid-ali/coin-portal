<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.2" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Development seed data (DevDataSeeder), never published -->
    <Content Update="DevData\**" CopyToPublishDirectory="Never" />
    <!-- Local database and admin; production settings come from the hosting environment -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <!-- Locally stored coin photos (PhotoStorage:RootPath), not part of the project or a publish -->
    <Content Remove="App_Data\**" />
    <None Remove="App_Data\**" />
    <Compile Remove="App_Data\**" />
  </ItemGroup>

  <!--
    A publish also builds the Angular client into wwwroot, so one package holds the whole site
    (SpaHosting serves it). The client gets the API's version for its footer. node_modules is
    installed only when missing: npm ci would wipe it under a running ng serve, and CI installs it
    in a step of its own. The local Angular CLI runs through npm exec with no download: npx would
    fetch an unrelated package named ng from the registry if node_modules lacked it. The licenses
    of the client's packages (Angular writes 3rdpartylicenses.txt) are published with it.
    SkipWebClient=true publishes the API alone.
  -->
  <PropertyGroup>
    <WebClientDir>$(MSBuildProjectDirectory)\..\web\</WebClientDir>
  </PropertyGroup>

  <Target Name="PublishWebClient" AfterTargets="ComputeFilesToPublish" DependsOnTargets="MinVer"
          Condition="'$(SkipWebClient)' != 'true'">
    <Exec Condition="!Exists('$(WebClientDir)node_modules\.bin\ng')" WorkingDirectory="$(WebClientDir)" Command="npm ci" />
    <Exec WorkingDirectory="$(WebClientDir)" Command="npm exec --no -- ng build --define &quot;APP_VERSION='$(MinVerVersion)'&quot;" />
    <ItemGroup>
      <WebClientFiles Include="$(WebClientDir)dist\web\browser\**" />
      <ResolvedFileToPublish Include="@(WebClientFiles)">
        <RelativePath>wwwroot\%(WebClientFiles.RecursiveDir)%(WebClientFiles.Filename)%(WebClientFiles.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(WebClientDir)dist\web\3rdpartylicenses.txt">
        <RelativePath>wwwroot\3rdpartylicenses.txt</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
